{
  "name": "esnaf-pos",
  "version": "1.0.0",
  "description": "Küçük esnaf için Hızlı Satış, Stok Takip ve Ön Muhasebe uygulaması",
  "private": true,
  "main": "electron/main.js",
  "scripts": {
    "dev": "concurrently -k \"cross-env BROWSER=none vite\" \"wait-on http://localhost:5173 && electron .\"",
    "build": "vite build",
    "build:electron": "npm run build && electron-builder",
    "preview": "vite preview"
  },
  "build": {
    "appId": "com.esnaf.pos",
    "productName": "Esnaf POS",
    "directories": {
      "output": "dist-app"
    },
    "files": [
      "dist/**/*",
      "electron/**/*",
      "node_modules/sql.js/**/*"
    ],
    "win": {
      "target": "nsis"
    }
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "typescript": "~5.6.0",
    "vite": "^6.3.0"
  },
  "dependencies": {
    "@vitejs/plugin-react": "^4.3.0",
    "concurrently": "^9.1.2",
    "cross-env": "^7.0.3",
    "electron": "^33.0.0",
    "electron-builder": "^25.1.8",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "sql.js": "^1.12.0",
    "wait-on": "^8.0.3"
  }
}
